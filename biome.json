{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "ignoreUnknown": false,
    "includes": ["**", "!dist"]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "formatter": {
    "enabled": false,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "useTemplate": "off"
      },
      "suspicious": {
        "noExplicitAny": "on",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": []
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  }
}
